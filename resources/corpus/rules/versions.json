{
  "rule": "versions",
  "classes": ["Versions"],
  "note": "Which of two versions comes first, including the suffix rules. This shipped wrong for a long time in both copies, in a way nobody could see: a '-beta' suffix sorted correctly while a '-beta.1' sorted backwards, and the release process happens to use the second form. Whoever installed a beta was told, forever, that they were up to date.",
  "operations": {
    "compare": { "in": { "a": "string?", "b": "string?" }, "out": "sign: negative when a is older, zero when equal, positive when a is newer" },
    "is_newer": { "in": { "current": "string?", "candidate": "string?" }, "out": "bool: candidate is strictly newer than current" }
  },
  "cases": [
    { "id": "versions/compare/ten-after-nine", "op": "compare", "in": { "a": "0.9.9", "b": "0.9.10" }, "out": -1, "symmetric": true,
      "why": "ten comes after nine — numbers are numbers, not text" },
    { "id": "versions/compare/sixty-six-after-nine", "op": "compare", "in": { "a": "0.9.9", "b": "0.9.66" }, "out": -1, "symmetric": true,
      "why": "sixty-six comes after nine" },
    { "id": "versions/compare/middle-outranks-last", "op": "compare", "in": { "a": "0.9.66", "b": "0.10.0" }, "out": -1, "symmetric": true,
      "why": "the middle field outranks the last one" },
    { "id": "versions/compare/first-outranks-both", "op": "compare", "in": { "a": "0.11.0", "b": "1.0.0" }, "out": -1, "symmetric": true,
      "why": "and the first outranks them both" },
    { "id": "versions/compare/two-digits", "op": "compare", "in": { "a": "2.0", "b": "10.0" }, "out": -1, "symmetric": true,
      "why": "two digits are not 'smaller' for starting with a one" },

    { "id": "versions/compare/missing-field-is-zero", "op": "compare", "in": { "a": "1.2", "b": "1.2.0" }, "out": 0, "symmetric": true,
      "why": "a missing field counts as zero" },
    { "id": "versions/compare/spare-field-is-zero", "op": "compare", "in": { "a": "1.2.0", "b": "1.2.0.0" }, "out": 0, "symmetric": true,
      "why": "and so does a spare one" },

    { "id": "versions/compare/final-replaces-beta", "op": "compare", "in": { "a": "0.11.0-beta.1", "b": "0.11.0" }, "out": -1, "symmetric": true,
      "why": "the final release replaces the beta — a suffix means 'not there yet', whatever it contains" },
    { "id": "versions/compare/suffix-without-number", "op": "compare", "in": { "a": "0.11.0-beta", "b": "0.11.0" }, "out": -1, "symmetric": true,
      "why": "with or without a number in the suffix" },
    { "id": "versions/compare/next-beta", "op": "compare", "in": { "a": "0.11.0-beta.1", "b": "0.11.0-beta.2" }, "out": -1, "symmetric": true,
      "why": "the next beta" },
    { "id": "versions/compare/alpha-before-beta", "op": "compare", "in": { "a": "0.11.0-alpha.9", "b": "0.11.0-beta.1" }, "out": -1, "symmetric": true,
      "why": "alpha before beta, whatever the numbers say" },
    { "id": "versions/compare/beta-before-rc", "op": "compare", "in": { "a": "0.11.0-beta.9", "b": "0.11.0-rc.1" }, "out": -1, "symmetric": true,
      "why": "beta before rc, same" },
    { "id": "versions/compare/saying-more-is-further", "op": "compare", "in": { "a": "0.11.0-beta", "b": "0.11.0-beta.1" }, "out": -1, "symmetric": true,
      "why": "saying more means being further along" },
    { "id": "versions/compare/version-read-first", "op": "compare", "in": { "a": "0.11.0-rc.1", "b": "0.11.1-beta.1" }, "out": -1, "symmetric": true,
      "why": "but the version itself is read first" },
    { "id": "versions/compare/number-below-word", "op": "compare", "in": { "a": "1.0.0-beta.1", "b": "1.0.0-beta.final" }, "out": -1, "symmetric": true,
      "why": "inside a suffix a number ranks below a word — the standard says so and it keeps 'beta.1' from outranking 'beta.final'" },

    { "id": "versions/compare/leading-v", "op": "compare", "in": { "a": "0.11.0", "b": "v0.11.0" }, "out": 0, "symmetric": true,
      "why": "the leading v of a git tag" },
    { "id": "versions/compare/leading-v-upper", "op": "compare", "in": { "a": "0.11.0", "b": "V0.11.0" }, "out": 0, "symmetric": true,
      "why": "in either case" },
    { "id": "versions/compare/surrounding-blanks", "op": "compare", "in": { "a": "0.11.0", "b": "  v0.11.0  " }, "out": 0, "symmetric": true,
      "why": "and surrounded by blanks" },
    { "id": "versions/compare/build-metadata-ignored", "op": "compare", "in": { "a": "0.11.0", "b": "0.11.0+build7" }, "out": 0, "symmetric": true,
      "why": "build metadata is not part of the version" },
    { "id": "versions/compare/all-noise-at-once", "op": "compare", "in": { "a": "0.11.0-beta.1", "b": "v0.11.0-beta.1+ci" }, "out": 0, "symmetric": true,
      "why": "both at once" },

    { "id": "versions/compare/two-empty-equal", "op": "compare", "in": { "a": "", "b": "" }, "out": 0, "symmetric": true,
      "why": "two empty strings are equal, not an error — nothing here may throw: an unreadable tag must not stop a program from starting" },
    { "id": "versions/compare/absent-is-older", "op": "compare", "in": { "a": "", "b": "1.0.0" }, "out": -1, "symmetric": true,
      "why": "an absent version is older than any version" },
    { "id": "versions/compare/null-is-older", "op": "compare", "in": { "a": null, "b": "1.0.0" }, "out": -1, "symmetric": true,
      "why": "including when it is null" },
    { "id": "versions/compare/unreadable-is-zero", "op": "compare", "in": { "a": "abc", "b": "0.0.1" }, "out": -1, "symmetric": true,
      "why": "a tag we cannot read counts as zero rather than crashing" },

    { "id": "versions/is_newer/newer-is-offered", "op": "is_newer", "in": { "current": "0.9.9", "candidate": "v0.9.10" }, "out": true,
      "why": "0.9.10 is newer than 0.9.9 — the question the calling code actually asks: do I offer this update?" },
    { "id": "versions/is_newer/older-is-not", "op": "is_newer", "in": { "current": "0.9.66", "candidate": "v0.9.9" }, "out": false,
      "why": "not the other way round" },
    { "id": "versions/is_newer/same-is-not", "op": "is_newer", "in": { "current": "0.11.0", "candidate": "v0.11.0" }, "out": false,
      "why": "the same version is not an update" },
    { "id": "versions/is_newer/beta-does-not-replace-release", "op": "is_newer", "in": { "current": "0.11.0", "candidate": "v0.11.0-beta.1" }, "out": false,
      "why": "a beta does not replace a published release" },
    { "id": "versions/is_newer/release-replaces-beta", "op": "is_newer", "in": { "current": "0.11.0-beta.1", "candidate": "v0.11.0" }, "out": true,
      "why": "but the published release replaces the beta" },
    { "id": "versions/is_newer/beta-replaces-previous-beta", "op": "is_newer", "in": { "current": "0.11.0-beta.1", "candidate": "v0.11.0-beta.2" }, "out": true,
      "why": "and one beta replaces the previous one" }
  ]
}
