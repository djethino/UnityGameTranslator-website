{
  "$comment": "The cases of the streams, in three kinds. `publish`: what the site puts on Redis for a given call (tests/Unit/SsePublisherContractTest.php). `frame`: bytes in the relay's own format and the events a client's parser must yield from them (Core.Checks/SseEventsChecks over Engine/SseStream). `read`: an event's data and what the mod's reader derives from it (same checks, over Engine/ApiReaders). check-spec.py holds every `data` here to the event's schema in sse-events.json.",
  "conventions": {
    "publish": "{publisher, args, channel, message, stored?}. `publisher` is a static method of App\\Services\\SsePublisher, `args` its arguments in order; `message` is the JSON published on `channel` (compared decoded); `stored` = {key, ttl_s, same_message: true} when the site also stores it for a client that was not listening, `null` when it does not. `sets` lists plain keys written (the announcement).",
    "frame": "{stream, text, stop_after_first?, events, retry_ms?, last_event_id?, stop}. `text` is the wire, `events` what the parser yields ({id, event, data} — data compared decoded), `stop` why the parser returned once the text ran out: Delivered (stopped on its one event) or EndOfStream.",
    "read": "{reader, payload, previous_payload?, input?, expects}. `reader` names the mod's reader; `previous_payload`, for sync_state, is a payload read first into the state the case's payload is then read OVER — that is the sequence the rule is about. `expects` are dotted paths of the derived record; `{\"$is\": ...}` as in api-v1."
  },
  "cases": [
    {
      "id": "sse-events/publish/device-authorized",
      "kind": "publish",
      "publisher": "deviceAuthorized",
      "args": [ "dEvIcE-code-0001", { "access_token": "ugt_abcDEF123", "token_type": "Bearer", "user": { "id": 7, "name": "alice" } } ],
      "channel": "sse:device:dEvIcE-code-0001",
      "message": { "event": "authorized", "data": { "access_token": "ugt_abcDEF123", "token_type": "Bearer", "user": { "id": 7, "name": "alice" } } },
      "stored": { "key": "sse:device:dEvIcE-code-0001:result", "ttl_s": 120, "same_message": true },
      "why": "the token is delivered here and nowhere else; stored two minutes for a client whose stream was not yet open, and the relay deletes it once served"
    },
    {
      "id": "sse-events/publish/device-expired",
      "kind": "publish",
      "publisher": "deviceExpired",
      "args": [ "dEvIcE-code-0001" ],
      "channel": "sse:device:dEvIcE-code-0001",
      "message": { "event": "expired", "data": { "error": "Device code expired" } },
      "stored": null,
      "why": "nothing to store: an expired code has no late client worth answering"
    },
    {
      "id": "sse-events/publish/announcing-a-code",
      "kind": "publish",
      "publisher": "expected",
      "args": [ "device", "dEvIcE-code-0001", 900 ],
      "channel": null,
      "message": null,
      "stored": { "key": "sse:device:dEvIcE-code-0001:pending", "ttl_s": 900, "value": "1" },
      "sets": { "sse:expected": "1" },
      "why": "a stream may only open on a code this site issued; the never-expiring marker is what lets the relay and the site deploy in any order"
    },
