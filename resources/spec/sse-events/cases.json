    {
      "id": "sse-events/frame/one-event-then-the-relay-closes",
      "kind": "frame",
      "stream": "device",
      "text": "retry: 3000\n\nid: 1\nevent: authorized\ndata: {\"access_token\":\"ugt_abcDEF123\",\"token_type\":\"Bearer\",\"user\":{\"id\":7,\"name\":\"alice\"}}\n\n",
      "stop_after_first": true,
      "retry_ms": 3000,
      "events": [ { "id": "1", "event": "authorized", "data": { "access_token": "ugt_abcDEF123", "token_type": "Bearer", "user": { "id": 7, "name": "alice" } } } ],
      "last_event_id": "1",
      "stop": "Delivered",
      "why": "the device stream carries exactly one event and is then closed on purpose: a client opened for one must stop on it, or the deliberate close reads as a lost connection over the top of the success"
    },
    {
      "id": "sse-events/frame/heartbeats-are-comments",
      "kind": "frame",
      "stream": "sync",
      "text": "retry: 3000\n\n: heartbeat\n\nid: 1\nevent: state\ndata: {\"exists\":false,\"role\":\"none\",\"translation\":null,\"main\":null,\"branches_count\":0,\"has_update\":false,\"vote\":null,\"accepts_branches\":null}\n\n: heartbeat\n\n: heartbeat\n\n",
      "retry_ms": 3000,
      "events": [ { "id": "1", "event": "state", "data": { "exists": false, "role": "none", "translation": null, "main": null, "branches_count": 0, "has_update": false, "vote": null, "accepts_branches": null } } ],
      "last_event_id": "1",
      "stop": "EndOfStream",
      "why": "a comment line keeps the connection alive and yields nothing; a stream that ends after them is an end of stream, which the client reconnects from"
    },
    {
      "id": "sse-events/frame/ids-count-per-connection",
      "kind": "frame",
      "stream": "edit",
      "text": "retry: 3000\n\nid: 1\nevent: edit_saved\ndata: {\"content_hash\":\"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"line_count\":4,\"saved_at\":\"2026-09-11T14:03:22+00:00\"}\n\nid: 2\nevent: browser_left\ndata: []\n\nid: 3\nevent: edit_session_ended\ndata: []\n\n",
      "retry_ms": 3000,
      "events": [
        { "id": "1", "event": "edit_saved", "data": { "content_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "line_count": 4, "saved_at": "2026-09-11T14:03:22+00:00" } },
        { "id": "2", "event": "browser_left", "data": [] },
        { "id": "3", "event": "edit_session_ended", "data": [] }
      ],
      "last_event_id": "3",
      "stop": "EndOfStream",
      "why": "ids count from 1 per connection and restart on a reconnect; the last one travels back as Last-Event-ID, which the relay ignores — what a client missed comes from the stored message"
    },
    {
      "id": "sse-events/frame/a-refusal-at-the-door",
      "kind": "frame",
      "stream": "sync",
      "text": "event: error\ndata: {\"error\":\"Invalid or expired token\"}\n\n",
      "events": [ { "id": null, "event": "error", "data": { "error": "Invalid or expired token" } } ],
      "last_event_id": null,
      "stop": "EndOfStream",
      "why": "no retry line, no id: one frame on an error status, then the relay closes — the status decides whether the client retries (401 does not)"
    },
    {
      "id": "sse-events/frame/access-revoked-mid-stream",
      "kind": "frame",
      "stream": "sync",
      "text": "retry: 3000\n\nid: 1\nevent: state\ndata: {\"exists\":true,\"role\":\"main\"}\n\nid: 2\nevent: error\ndata: {\"error\":\"Access revoked\",\"code\":\"revoked\"}\n\n",
      "retry_ms": 3000,
      "events": [
        { "id": "1", "event": "state", "data": { "exists": true, "role": "main" } },
        { "id": "2", "event": "error", "data": { "error": "Access revoked", "code": "revoked" } }
      ],
      "last_event_id": "2",
      "stop": "EndOfStream",
      "why": "named rather than silently closed: a stream that simply ends looks like a network blip and the client reconnects; `code: revoked` is what makes it sign out instead"
    },

