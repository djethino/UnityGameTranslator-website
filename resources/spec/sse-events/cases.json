      "channel": "sse:edit:KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK",
      "message": { "event": "edit_saved", "data": { "content_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "line_count": 4, "saved_at": "2026-09-11T14:03:22+00:00" } },
      "stored": { "key": "sse:edit:KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK:result", "ttl_s": 900, "same_message": true },
